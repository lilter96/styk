DATABASE_URL=postgres://styk:styk_local@localhost:55432/styk?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Optional local console; provide a random secret of at least 32 characters.
STYK_OPERATOR_SECRET=
STYK_CONSOLE_ORIGIN=http://127.0.0.1:5173
# Review lifetime must be positive and no greater than 10 minutes.
STYK_REVIEW_LIFETIME=5m
QUERY_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_RETRY_DELAY=2s
WORKER_MAX_ATTEMPTS=3
# Required only for the read-only import; do not commit real tokens.
MOYSKLAD_TOKEN=
MOYSKLAD_ACCOUNT_ID=
MOYSKLAD_HTTP_TIMEOUT=30s
MOYSKLAD_REQUEST_INTERVAL=400ms
MOYSKLAD_RETRY_BACKOFF=1s
MOYSKLAD_MAX_RETRY_AFTER=1m
MOYSKLAD_MAX_ATTEMPTS=3
# Ozon read-only import; use credentials with only required permissions.
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_HTTP_TIMEOUT=30s
OZON_REQUEST_INTERVAL=400ms
OZON_RETRY_BACKOFF=1s
OZON_MAX_RETRY_AFTER=1m
OZON_MAX_ATTEMPTS=3

# Catalog metadata writes: only the fixed owner-controlled test account pair.
# This does not enable stock publication or arbitrary real merchant accounts.
STYK_TEST_ACCOUNT_CATALOG=false
# Secret-free actual HTTP attempt diagnostics; bodies and credentials are excluded.
STYK_CATALOG_REQUEST_AUDIT=false
